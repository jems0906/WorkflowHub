{
  "name": "workflowhub",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/run-backend.ps1 dev",
    "start": "powershell -ExecutionPolicy Bypass -File scripts/run-backend.ps1 start",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "db:migrate": "npm run migrate --prefix backend",
    "db:seed": "npm run seed --prefix backend",
    "smoke:api": "powershell -ExecutionPolicy Bypass -File scripts/smoke-api.ps1",
    "smoke:rbac": "powershell -ExecutionPolicy Bypass -File scripts/smoke-rbac.ps1",
    "smoke:all": "powershell -ExecutionPolicy Bypass -File scripts/smoke-all.ps1",
    "preflight": "powershell -ExecutionPolicy Bypass -File scripts/preflight.ps1",
    "jwt:generate": "powershell -ExecutionPolicy Bypass -File scripts/generate-jwt-secret.ps1"
  }
}
